{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "components/*": [
        "./src/components/*"
      ],
      "components": [
        "./src/components/index.ts"
      ],
      "api/*": [
        "./src/api/*"
      ],
      "lib/*": [
        "./src/lib/*"
      ],
      "adapters/*": [
        "./src/adapters/*"
      ],
      "constants/*": [
        "./src/constants/*"
      ],
      "constants": [
        "./src/constants/index.ts"
      ],
      "contexts/*": [
        "./src/contexts/*"
      ],
      "hooks/*": [
        "./src/hooks/*"
      ],
      "store/*": [
        "./src/store/*"
      ],
      "layout/*": [
        "./src/layout/*"
      ],
      "layout": [
        "./src/layout/index.tsx"
      ],
      "types/*": [
        "./src/types/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}

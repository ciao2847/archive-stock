import assert from "node:assert/strict";
import test from "node:test";
import { build } from "esbuild";
import type { FanmadeBatchDraftRow } from "../src/lib/fanmade/batch-feedback.ts";

const bundle = await build({
  entryPoints: ["src/lib/fanmade/batch-feedback.ts"],
  bundle: true,
  write: false,
  format: "esm",
  platform: "node",
});
const { validateFanmadeBatchDraft } = (await import(
  `data:text/javascript;base64,${Buffer.from(bundle.outputFiles[0].text).toString("base64")}`
)) as typeof import("../src/lib/fanmade/batch-feedback.ts");

function row(
  index: number,
  overrides: Partial<FanmadeBatchDraftRow> = {},
): FanmadeBatchDraftRow {
  return {
    key: `row-${index}`,
    imageKey: `image-${index}`,
    ip: "蜘蛛人",
    title: `夜景${index}`,
    craft: "亮銀龍",
    stock: "10",
    ...overrides,
  };
}

test("pre-upload feedback accepts one poster with three crafts and another with two", () => {
  const rows = [
    row(0, { imageKey: "first", craft: "亮銀龍" }),
    row(1, { imageKey: "first", craft: "水波紋", stock: "6" }),
    row(2, { imageKey: "first", craft: "雷射", stock: "0" }),
    row(3, { imageKey: "second", craft: "亮銀龍" }),
    row(4, { imageKey: "second", craft: "水波紋", stock: "8" }),
  ];
  assert.equal(validateFanmadeBatchDraft(rows), null);
  assert.ok(rows.every((item) => item.paths === undefined));
});

test("a long autogenerated filename is rejected before upload with its exact row location", () => {
  const long = row(1, { title: "夜".repeat(201) });
  const feedback = validateFanmadeBatchDraft([row(0), long]);
  assert.equal(feedback?.rowKey, long.key);
  assert.equal(feedback?.imageKey, long.imageKey);
  assert.equal(feedback?.field, "title");
  assert.match(feedback?.message ?? "", /海報名稱最多 200 字/);
  assert.ok((feedback?.message.length ?? 0) < 120);
  assert.equal(long.title.length, 201);
});

test("trimmed blank IP, title, and craft are identified with actionable field feedback", () => {
  for (const field of ["ip", "title", "craft"] as const) {
    const item = row(2, { [field]: " \n\t " });
    const feedback = validateFanmadeBatchDraft([row(0), item]);
    assert.equal(feedback?.field, field, field);
    assert.equal(feedback?.rowKey, item.key, field);
    assert.equal(feedback?.imageKey, item.imageKey, field);
    assert.match(feedback?.message ?? "", /尚未填寫/, field);
  }
  assert.equal(
    validateFanmadeBatchDraft([
      row(0, { ip: " 蜘蛛人 ", title: " 夜景 ", craft: " 亮銀龍 " }),
    ]),
    null,
  );
});

test("all individual name limits are enforced independently of the combined-name limit", () => {
  for (const [field, limit] of [
    ["ip", 200],
    ["title", 200],
    ["craft", 100],
  ] as const) {
    assert.equal(
      validateFanmadeBatchDraft([row(0, { [field]: "字".repeat(limit) })]),
      null,
      `${field} at the allowed limit`,
    );
    const feedback = validateFanmadeBatchDraft([
      row(0, { [field]: "字".repeat(limit + 1) }),
    ]);
    assert.equal(feedback?.field, field);
    assert.match(feedback?.message ?? "", new RegExp(`最多 ${limit} 字`));
  }
});

test("blank, fractional and out-of-range stock is never silently converted to valid zero", () => {
  for (const stock of ["", "   ", "1.5", "-1", "1001", "NaN", "Infinity"]) {
    const feedback = validateFanmadeBatchDraft([row(0, { stock })]);
    assert.equal(feedback?.field, "stock", stock);
    assert.equal(feedback?.rowKey, "row-0", stock);
    assert.match(feedback?.message ?? "", /0 至 1000.*整數/, stock);
  }
  for (const stock of ["0", "1000", " 7 "])
    assert.equal(validateFanmadeBatchDraft([row(0, { stock })]), null, stock);
});

test("real image paths are validated and a mismatched thumbnail points at that image", () => {
  const first = "00000000-0000-4000-8000-000000000001";
  const second = "00000000-0000-4000-8000-000000000002";
  assert.equal(
    validateFanmadeBatchDraft([
      row(0, { paths: [`${first}/main.webp`, `${first}/thumb.webp`] }),
    ]),
    null,
  );
  for (const paths of [
    ["not-a-product-path", `${first}/thumb.webp`],
    [`${first}/main.webp`, `${second}/thumb.webp`],
    [`${first}/main.webp`, `${first}/main.webp`],
  ] as Array<[string, string]>) {
    const feedback = validateFanmadeBatchDraft([row(0, { paths })]);
    assert.equal(feedback?.field, "imagePaths");
    assert.equal(feedback?.imageKey, "image-0");
    assert.match(feedback?.message ?? "", /圖片/);
  }
});

test("combined names use the same 300-character boundary as the submitted schema", () => {
  const item = row(0, {
    ip: "蛛".repeat(80),
    title: "夜".repeat(176),
    craft: "銀".repeat(40),
  });
  assert.equal([...`🎨 ${item.ip}／${item.title}｜${item.craft}`].length, 300);
  assert.equal(validateFanmadeBatchDraft([item]), null);
  const feedback = validateFanmadeBatchDraft([
    { ...item, title: item.title + "景" },
  ]);
  assert.equal(feedback?.rowKey, item.key);
  assert.match(feedback?.message ?? "", /合計最多 300 字/);
});

test("empty and oversized batches report their actual batch limit before per-row errors", () => {
  assert.match(
    validateFanmadeBatchDraft([])?.message ?? "",
    /至少一張海報圖片/,
  );
  assert.equal(
    validateFanmadeBatchDraft(
      Array.from({ length: 50 }, (_, index) => row(index)),
    ),
    null,
  );
  const feedback = validateFanmadeBatchDraft(
    Array.from({ length: 51 }, (_, index) => row(index, { stock: "" })),
  );
  assert.match(feedback?.message ?? "", /最多 50.*51/);
  assert.equal(feedback?.rowKey, undefined);
});

test("validation leaves frozen rows, path tuples, and selected media identities untouched", () => {
  const file = new File(["image"], "poster.png", { type: "image/png" });
  const video = new File(["video"], "silver.mov", { type: "video/quicktime" });
  const first = Object.freeze({ ...row(0), file, video });
  const paths = Object.freeze([
    "00000000-0000-4000-8000-000000000001/main.webp",
    "00000000-0000-4000-8000-000000000001/thumb.webp",
  ] as const);
  const second = Object.freeze({ ...row(1, { paths }), file, stock: " 7 " });
  const rows = Object.freeze([first, second]);
  assert.equal(validateFanmadeBatchDraft(rows), null);
  assert.equal(rows[0], first);
  assert.equal(rows[1], second);
  assert.equal(first.file, file);
  assert.equal(first.video, video);
  assert.equal(Object.hasOwn(first, "paths"), false);
  assert.equal(second.paths, paths);
  assert.equal(second.stock, " 7 ");
});
